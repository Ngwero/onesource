# Shop auth (Supabase → Project Settings → API → anon public key)
# Required for Railway build (Vite embeds these at build time).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Optional — defaults to "images". Used to resolve /uploads/* to Supabase Storage in production.
# VITE_SUPABASE_STORAGE_BUCKET=images
# Storage → Image Transformations (Pro). On unless this is false.
# VITE_SUPABASE_IMAGE_TRANSFORMS=true

# Not needed on Railway (shop and API share one domain). Only for split hosting:
# VITE_API_URL=https://your-api-host.com/api

# Optional Sentry (web) — no-op without DSN; install @sentry/react when enabling
# VITE_SENTRY_DSN=

# Optional Vite feature-flag mirrors (hide UI locally without API). Prefer server FEATURE_*.
# VITE_FEATURE_WISHLISTS=1
# VITE_FEATURE_WISHLISTS_SHARE=1
# VITE_FEATURE_TIMED_DEALS=1
# VITE_FEATURE_MEMBERSHIP=1
# VITE_FEATURE_CART_UPSELL=1
# VITE_FEATURE_RETURNS=1
# VITE_FEATURE_SUPPORT_CHAT=1
# VITE_FEATURE_PUSH=1
# VITE_FEATURE_SUBSCRIPTIONS=1
# VITE_FEATURE_MARKETPLACE=1

