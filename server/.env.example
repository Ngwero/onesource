# Copy to .env:  cp .env.example .env
# Validate:      npm run check:env
#
# Supabase → Project Settings → API (use the service role key, not the anon key)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Required for login OTP verification on the server (same as VITE_SUPABASE_ANON_KEY)
SUPABASE_ANON_KEY=your-anon-public-key

# Shop frontend (project root .env — use the anon public key, NOT the service role key)
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

PORT=3001

# Shop URL used in password-reset emails (logo links, footer, redirect fallback)
# On Railway, SHOP_URL is optional — https://RAILWAY_PUBLIC_DOMAIN is used automatically
SHOP_URL=http://localhost:5174

# SMTP — optional for local/dev. Railway Hobby blocks outbound SMTP ports.
# Prefer BREVO_API_KEY (HTTPS) on Railway production.
SMTP_HOST=mail.one-sourcebrand.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@one-sourcebrand.com
SMTP_PASS=your-email-account-password
SMTP_FROM="One Source <noreply@one-sourcebrand.com>"

# Recommended on Railway (works on Hobby — HTTPS, not SMTP):
# 1. Create free account at https://www.brevo.com
# 2. Settings → SMTP & API → API Keys → Generate
# 3. Senders → add/verify noreply@one-sourcebrand.com (or your domain)
# 4. Set on Railway:
# BREVO_API_KEY=xkeysib-...
# SMTP_FROM="One Source <noreply@one-sourcebrand.com>"
#
# Alternative HTTPS provider:
# RESEND_API_KEY=re_...
#
# Or host server/cpanel/send-app-mail.php on cPanel and set:
# CPANEL_MAIL_URL=https://one-sourcebrand.com/onesource-api/send-app-mail.php
# CPANEL_MAIL_SECRET=long-random-secret-matching-php

# Login OTP validity in seconds (default 300 = 5 minutes)
# OTP_TTL_SECONDS=300

# Optional QA: fixed 6-digit login OTP for one email
# FIXED_LOGIN_OTP_EMAIL=engwero@gmail.com
# FIXED_LOGIN_OTP=246810
# FIXED_LOGIN_OTP_DISABLED=1

# Uploads: saved as WebP — when Supabase is configured, uploads go to Storage automatically (live on shop + Railway).
# Set USE_SUPABASE_STORAGE=false only for offline local-only dev without cloud.
USE_SUPABASE_STORAGE=true
# SUPABASE_STORAGE_BUCKET=images

# Feature flags (default on in non-production; production defaults all off).
# See docs/staged-rollout.md
# FEATURE_WISHLISTS=1
# FEATURE_WISHLISTS_SHARE=1
# FEATURE_TIMED_DEALS=1
# FEATURE_DEALS=1
# FEATURE_MEMBERSHIP=1
# MEMBER_FREE_DELIVERY_THRESHOLD_UGX=50000
# FEATURE_CART_UPSELL=1
# FEATURE_RETURNS=1
# FEATURE_SUPPORT_CHAT=1
# FEATURE_CHAT=1
# FEATURE_PUSH=1
# FEATURE_SUBSCRIPTIONS=1
# FEATURE_MARKETPLACE=1
# FEATURE_SENTRY=1
# FEATURE_FLAGS_JSON={"timedDeals":true,"cartUpsell":true}
# FEATURE_FLAGS_BY_REGION={"UG":{"timedDeals":true},"KE":{"timedDeals":false}}
# FEATURE_REGION=UG
# FEATURE_FLAGS_URL=https://example.com/onesource-flags.json

# Cron secret for POST /api/internal/run-subscription-ticks
# INTERNAL_CRON_SECRET=long-random-secret

# Optional push providers (hooks log when unset)
# FCM_SERVER_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Sentry (no-op without DSN)
# SENTRY_DSN=

