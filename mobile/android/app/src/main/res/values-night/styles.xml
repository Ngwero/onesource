<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Keep One Source light even when the phone is in Dark Mode — Black.NoTitleBar
         was showing through transparent Flutter scaffolds as solid black pages. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/onesource_canvas</item>
    </style>
</resources>
